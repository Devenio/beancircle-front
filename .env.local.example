# Copy to .env.local for local development (or use: cp .env.local.example .env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Optional: use in-browser mock data instead of the API
# NEXT_PUBLIC_USE_MOCK_DATA=true

# Neshan map API key (https://platform.neshan.org). Use a "web" service key.
NEXT_PUBLIC_NESHAN_API_KEY=web.your-key-here
