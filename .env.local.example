# Copy to .env.local for local development (or use: cp .env.local.example .env.local)

# Backend the Next dev server proxies /api/v1 and /socket.io to. The browser
# talks to the page's own origin, so the app works on localhost, a LAN IP, or a
# phone over a tunnel with no rebuild. Match this to the API's PORT.
API_PROXY_TARGET=http://localhost:3001

# Set these ONLY when the API/realtime lives on a different origin than the
# frontend (e.g. production). Leave unset for local + tunnel dev so the
# same-origin proxy above is used.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_WS_URL=https://api.example.com

# Optional: use in-browser mock data instead of the API
# NEXT_PUBLIC_USE_MOCK_DATA=true

# Neshan map API key (https://platform.neshan.org). Use a "web" service key.
NEXT_PUBLIC_NESHAN_API_KEY=web.your-key-here
